# credit: http://nparikh.org/notes/zshrc.txt
# Usage: extract <file>
# Description: extracts archived files / mounts disk images
# Note: .dmg/hdiutil is macOS-specific; .zst/.7z/.rar need zstd/7z/unrar installed.
extract () {
    if [[ -f $1 ]]; then
        case $1 in
            *.tar.bz2|*.tbz2)  tar -jxvf "$1"                      ;;
            *.tar.gz|*.tgz)    tar -zxvf "$1"                      ;;
            *.tar.xz|*.txz)    tar -Jxvf "$1"                      ;;
            *.tar.zst)         zstd -dc -- "$1" | tar -xvf -       ;;
            *.tar)             tar -xvf "$1"                       ;;
            *.bz2)             bunzip2 "$1"                        ;;
            *.gz)              gunzip "$1"                         ;;
            *.xz)              unxz "$1"                           ;;
            *.zst)             zstd -d -- "$1"                     ;;
            *.dmg)             hdiutil mount "$1"                  ;;
            *.zip|*.ZIP)       unzip "$1"                          ;;
            *.7z)              7z x "$1"                           ;;
            *.pax)             pax -r < "$1"                       ;;
            *.pax.Z)           uncompress -c "$1" | pax -r         ;;
            *.rar)             unrar x "$1"                        ;;
            *.Z)               uncompress "$1"                     ;;
            *)                 echo "'$1' cannot be extracted/mounted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}
